<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <id>io.github.xyproto.zsnes</id>
  <name>ZSNES</name>
  <summary>Super Nintendo emulator</summary>
  <launchable type="desktop-id">io.github.xyproto.zsnes.desktop</launchable>
  <developer id="io.github.xyproto">
    <name>Alexander F. Rødseth</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>
  <description>
    <p>ZSNES is a Super Nintendo emulator. Development started in 1998, and for years it was one of the most widely used SNES emulators.</p>
    <p>This is a continuation of that project: the 32-bit x86 assembly the original was built on has been ported to C11, so it builds and runs on current systems and on 64-bit and non-x86 machines. It aims at broad game compatibility, good keyboard and joystick support and a solid audio path rather than at circuit-level accuracy.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>The ZSNES menu</caption>
      <image type="source" width="512" height="448">https://raw.githubusercontent.com/xyproto/zsnes/main/img/screenshot.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="2.3.0" date="2026-08-29" type="development"/>
    <release version="2.0.10" date="2022-06-13" type="stable"/>
    <release version="2.0.9" date="2021-08-18" type="stable"/>
  </releases>
  <url type="homepage">https://github.com/xyproto/zsnes</url>
  <url type="bugtracker">https://github.com/xyproto/zsnes/issues</url>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
  </recommends>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>zsnes</binary>
    <mediatype>application/vnd.nintendo.snes.rom</mediatype>
    <mediatype>application/x-snes-rom</mediatype>
  </provides>
</component>
