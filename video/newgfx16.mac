    jne near .no8bit2
    shr ecx,6
    add edi,esi
    mov [ngptrdat+%2*1024+ebx*4],ecx
    mov [ngptrdat2],ecx
    mov [ngceax+%2*1024+ebx*4],eax
    mov [ngcedi+%2*1024+ebx*4],edi
    test byte[scadsng+ebx],1
    jz .nodirect2
    mov dl,[vidbright]
    cmp dl,[prevbrightdc]
    je .nodcchange2
    mov [prevbrightdc],dl
    ccallv Gendcolortable
.nodcchange2
    mov ecx,dcolortab
    mov [CPalPtrng],ecx
.nodirect2
