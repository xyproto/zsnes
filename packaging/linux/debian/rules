#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

# Match upstream's architecture-specific position-independence policy.
# Upstream links 32-bit x86 non-PIE. Retain Debian's PIE hardening on
# amd64, arm64 and riscv64.
ifeq ($(DEB_HOST_ARCH),i386)
export DEB_BUILD_MAINT_OPTIONS = hardening=+all,-pie
else
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
endif

export CFLAGS := $(shell dpkg-buildflags --get CFLAGS)
export LDFLAGS := $(shell dpkg-buildflags --get LDFLAGS)

SUPPORTED_ARCHES := amd64 i386 arm64 riscv64

ifeq ($(DEB_HOST_ARCH),amd64)
UPSTREAM_BITS := 64
UPSTREAM_CPU := x86
else ifeq ($(DEB_HOST_ARCH),i386)
UPSTREAM_BITS := 32
UPSTREAM_CPU := x86
else ifeq ($(DEB_HOST_ARCH),arm64)
UPSTREAM_BITS := 64
UPSTREAM_CPU := arm64
else ifeq ($(DEB_HOST_ARCH),riscv64)
UPSTREAM_BITS := 64
UPSTREAM_CPU := riscv64
endif

%:
	dh $@

override_dh_auto_configure:
	@case " $(SUPPORTED_ARCHES) " in \
		*" $(DEB_HOST_ARCH) "*) ;; \
		*) \
			echo "Unsupported ZSNES architecture: $(DEB_HOST_ARCH)" >&2; \
			echo "Supported architectures: $(SUPPORTED_ARCHES)" >&2; \
			exit 1; \
			;; \
	esac

override_dh_auto_build:
	dh_auto_build -- \
		ARCH=LINUX \
		BITS=$(UPSTREAM_BITS) \
		CPU=$(UPSTREAM_CPU) \
		WITH_SDL=yes \
		WITH_PIPEWIRE=yes \
		WITH_AO=yes

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	dh_auto_test -- \
		ARCH=LINUX \
		BITS=$(UPSTREAM_BITS) \
		CPU=$(UPSTREAM_CPU) \
		WITH_SDL=yes \
		WITH_PIPEWIRE=yes \
		WITH_AO=yes
endif

override_dh_auto_install:
	install -Dm755 zsnes "$(CURDIR)/debian/zsnes/usr/bin/zsnes"
	set -e; \
	for ICON_SIZE in 16x16 32x32 48x48 64x64 128x128; do \
		install -Dm644 "img/$${ICON_SIZE}x32.png" \
			"$(CURDIR)/debian/zsnes/usr/share/icons/hicolor/$$ICON_SIZE/apps/io.github.xyproto.zsnes.png"; \
	done
	install -d "$(CURDIR)/debian/zsnes/usr/share/applications"
	sed 's|^Exec=zsnes |Exec=/usr/bin/zsnes |' linux/zsnes.desktop \
		> "$(CURDIR)/debian/zsnes/usr/share/applications/io.github.xyproto.zsnes.desktop"
	chmod 0644 "$(CURDIR)/debian/zsnes/usr/share/applications/io.github.xyproto.zsnes.desktop"
	install -m644 \
		debian/io.github.xyproto.zsnes.pipewire.desktop \
		debian/io.github.xyproto.zsnes.sdl3.desktop \
		debian/io.github.xyproto.zsnes.libao.desktop \
		"$(CURDIR)/debian/zsnes/usr/share/applications/"
	install -Dm644 linux/io.github.xyproto.zsnes.metainfo.xml \
		"$(CURDIR)/debian/zsnes/usr/share/metainfo/io.github.xyproto.zsnes.metainfo.xml"
	install -Dm644 man/zsnes.1 \
		"$(CURDIR)/debian/zsnes/usr/share/man/man1/zsnes.1"

override_dh_auto_clean:
	dh_auto_clean
	$(MAKE) -C test clean
